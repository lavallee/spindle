#!/usr/bin/env python3
"""Run the exact Spindle source shipped in this plugin or installed wheel."""

from __future__ import annotations

import sys
from pathlib import Path


if sys.version_info < (3, 11):
    raise SystemExit("Spindle requires Python 3.11 or newer")

plugin_source = Path(__file__).resolve().parents[3] / "src"
if (plugin_source / "spindle" / "cli.py").is_file():
    sys.path.insert(0, str(plugin_source))

from spindle.cli import main  # noqa: E402


raise SystemExit(main())
